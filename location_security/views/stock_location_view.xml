<?xml version="1.0"?>
<odoo>
    <record id="view_location_form" model="ir.ui.view">
        <field name="name">location_security.stock.location.form</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <group name="additional_info" position="inside">
                <field name="restricted_user_ids" widget="many2many_tags" readonly="1" invisible="not restricted_user_ids" groups="stock.group_stock_manager"/>
            </group>
        </field>
    </record>
</odoo>
