<odoo>

    <!-- stock.picking.batch list view -->
    <record model="ir.ui.view" id="stock_batch_picking_search">
        <field name="name">stock.picking.batch.form</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <!-- Al buscar por picking busca por nro de remito -->
                <field name="picking_ids"/>
                <field name="picking_type_code"/>
            </field>
            <group>
                <filter name="picking_type_code" string="Type of Operation" context="{'group_by':'picking_type_code'}"/>
            </group>
        </field>
    </record>

    <!-- stock.picking.batch list view -->
    <record model="ir.ui.view" id="stock_batch_picking_tree">
        <field name="name">stock.picking.batch.form</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="partner_id" optional="show"/>
                <field name="picking_type_code"/>
            </field>
        </field>
    </record>

    <!-- stock.picking.batch form view -->
    <record model="ir.ui.view" id="stock_batch_picking_form">
        <field name="name">stock.picking.batch.form</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_form"/>
        <field name="arch" type="xml">

            <button name="action_cancel" position="attributes">
                <attribute name="groups">stock_ux.allow_picking_cancellation</attribute>
            </button>

            <!-- Reemplazamos el botón Print nativo (visible para in_progress y done)
                 por dos botones: uno para in_progress (batch transfer) y otro
                 para done (delivery slip), igual que en los pickings nativos. -->
            <button name="action_print" position="replace">
                <button name="action_print" invisible="state != 'in_progress'" string="Print" type="object" data-hotkey="o"/>
                <button name="%(stock_batch_picking_ux.action_report_batch_deliveryslip)d" invisible="state != 'done'" string="Print" type="action" data-hotkey="o"/>
            </button>

            <xpath expr="//div" position="inside">
                <button name="action_view_stock_picking" class="oe_stat_button" icon="fa-truck" type="object">
                    <div class="o_form_field o_stat_info">
                        <field string="Pickings" name="picking_count" widget="statinfo" />
                    </div>
                </button>
            </xpath>
            <field name="picking_type_id" position="before">
                <field name="partner_id"
                       readonly="state in ('done', 'cancel')"
                       context="{'res_partner_search_mode': picking_type_code == 'incoming' and 'supplier' or 'customer'}"/>
            </field>
            <!-- dejamos user despues de type para que quede mas parecido a pickings -->
            <field name="picking_type_id" position="after">
                <field name="user_id" position="move"/>
            </field>
            <group id="batch_delivery_data" position="after">
                <group id="column2">
                    <field name="number_of_packages" invisible="picking_type_code == 'incoming' or not partner_id"/>
                </group>
            </group>
            <!-- dejamos scheduled_date del lado derecho igual que en pickings -->
            <field name="number_of_packages" position="before">
                <field name="scheduled_date" position="move"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Notes">
                    <field name="notes" colspan="4" nolabel="1"/>
                </page>
            </xpath>
        </field>

    </record>

</odoo>
