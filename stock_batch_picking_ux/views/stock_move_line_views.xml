<odoo>

    <record id="view_move_tree" model="ir.ui.view">
        <field name="name">stock.move.list</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock_picking_batch.view_picking_move_tree_inherited"/>
        <field name="arch" type="xml">
            <!-- we only show origin if we came from a batch, on a picking you already have it on the picking -->
            <field name="product_id" position="before">
                <field name="origin" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_tree" model="ir.ui.view">
        <field name="name">stock.move.line.list</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock_picking_batch.view_move_line_tree"/>
        <field name="arch" type="xml">
            <!-- we only show origin if we came from a batch, on a picking you already have it on the picking -->
            <field name="product_id" position="before">
                <field name="origin" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_tree_smart_button" model="ir.ui.view">
        <field name="name">stock.move.line.list.smart.button</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="view_move_line_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity'][@invisible='1']" position="replace"/>
            <xpath expr="//field[@name='quantity'][not(@invisible='1')]" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
            <field name="product_id" position="after">
                <field name="description_picking" string="Descripción del producto" readonly="1"/>
            </field>
            <field name="lot_id" position="attributes">
                <attribute name="domain">[('product_id', '=', product_id), '|', ('company_id', '=', False), ('company_id', '=', company_id)]</attribute>
            </field>
        </field>
    </record>

</odoo>
