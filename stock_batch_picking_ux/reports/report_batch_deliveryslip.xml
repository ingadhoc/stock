<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Entry point: iterates over batch records and renders one document per batch.
        Analogous to stock.report_deliveryslip → stock.report_delivery_document.
        l10n_ar_stock_picking_batch can override report_batch_delivery_document
        with primary="True" to add the Argentine look, just as l10n_ar_stock_ux
        does for stock.report_delivery_document.
    -->
    <template id="report_batch_deliveryslip">
        <t t-foreach="docs" t-as="o">
            <t t-call="stock_batch_picking_ux.report_batch_delivery_document"/>
        </t>
    </template>

    <!--
        Batch delivery document.
        Inherits stock.report_delivery_document as PRIMARY so it becomes an
        independent template.  Only the parts that differ for a batch are
        patched; the line tables (stock_move_table / stock_move_line_table) and
        their sub-template calls are reused as-is.

        Patches applied:
          1. Remove _get_report_lang() call  – batch has no such method.
          2. Remove address / information_block blocks  – no delivery-address
             logic needed at this level.
          3. Replace h2 title and informations div with batch fields.
          4. Fix state condition on demand table  – exclude 'cancel' state.
          5. has_multi_level_packages = False  – batch has no package_history_ids.
          6. Replace packages_count branch  – derive packages from move_line_ids.
          7. Remove backorders section  – batch has no backorder_ids.
          8. Remove signature section  – batch has no signature field.
    -->
    <template id="report_batch_delivery_document"
              inherit_id="stock.report_delivery_document"
              primary="True">

        <!-- 1. Use o directly: _get_report_lang() does not exist on batch -->
        <t t-set="o" position="attributes">
            <attribute name="t-value">o</attribute>
        </t>

        <!-- Batch partner is directly o.partner_id -->
        <t t-set="partner" position="attributes">
            <attribute name="t-value">o.partner_id or False</attribute>
        </t>

        <!-- 2. Remove address block (calls should_print_delivery_address()) -->
        <t t-set="address" position="replace">
            <t t-set="address" t-value="False"/>
        </t>

        <!-- 2. Remove information_block (no vendor/customer address for batch) -->
        <t t-set="information_block" position="replace">
            <t t-set="information_block" t-value="False"/>
        </t>

        <!-- 3. Replace document title -->
        <h2 position="replace">
            <h2 style="margin-top: 15px;">
                Batch Transfer
                <span t-field="o.name"/>
            </h2>
        </h2>

        <!-- 3. Replace informations block with batch-specific fields -->
        <div id="informations" position="replace">
            <div id="informations" class="report-wrapping-flexbox clearfix row mb-4">
                <div t-if="o.scheduled_date" class="col col-3 mw-100 mb-2" name="div_sched_date">
                    <strong>Scheduled Date</strong>
                    <div t-field="o.scheduled_date" class="m-0"/>
                </div>
                <div t-if="o.user_id" class="col-auto" name="div_operator">
                    <strong>Responsible:</strong>
                    <p t-field="o.user_id"/>
                </div>
                <div t-if="o.picking_type_id" class="col col-3 mw-100 mb-2" name="div_operation_type">
                    <strong>Operation Type:</strong>
                    <p t-field="o.picking_type_id"/>
                </div>
            </div>
        </div>

        <!-- 4. Demand table: also exclude 'cancel' (batch has this extra state) -->
        <table name="stock_move_table" position="attributes">
            <attribute name="t-if">o.state not in ('done', 'cancel')</attribute>
        </table>

        <!-- 5. Batch has no package_history_ids: multi-level packages not applicable -->
        <t t-set="has_multi_level_packages" position="attributes">
            <attribute name="t-value">False</attribute>
        </t>

        <!-- 6. Replace packages_count branch: batch derives packages from move_line_ids -->
        <t t-if="o.packages_count" position="replace">
            <t t-set="result_packages"
               t-value="o.move_line_ids.filtered(lambda l: l.result_package_id).mapped('result_package_id')"/>
            <t t-if="result_packages" name="has_packages">
                <t t-foreach="result_packages" t-as="package">
                    <t t-call="stock.stock_report_delivery_package_section_line"/>
                    <t t-set="package_move_lines"
                       t-value="o.move_line_ids.filtered(
                           lambda l: l.result_package_id == package
                       ).sorted('product_id')"/>
                    <t t-if="has_serial_number">
                        <tr t-foreach="package_move_lines" t-as="move_line">
                            <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                        </tr>
                    </t>
                    <t t-else="">
                        <t t-set="aggregated_lines"
                           t-value="package_move_lines._get_aggregated_product_quantities(strict=True)"/>
                        <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>
                    </t>
                </t>
                <t t-set="move_lines"
                   t-value="o.move_line_ids.filtered(lambda l: not l.result_package_id)"/>
                <t t-set="aggregated_lines"
                   t-value="o.move_line_ids._get_aggregated_product_quantities(except_package=True)"/>
                <t t-if="move_lines or aggregated_lines" name="no_package_move_lines">
                    <t t-call="stock.stock_report_delivery_no_package_section_line" name="no_package_section"/>
                    <t t-if="has_serial_number">
                        <tr t-foreach="move_lines" t-as="move_line">
                            <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                        </tr>
                    </t>
                    <t t-elif="aggregated_lines">
                        <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>
                    </t>
                </t>
            </t>
        </t>

        <!-- 7. Remove backorders section: batch has no backorder_ids -->
        <xpath expr="//t[@t-set='backorders']" position="replace"/>
        <xpath expr="//div[contains(@t-if, 'backorder_ids')]" position="replace">
            <div class="oe_structure"/>
        </xpath>
        <xpath expr="//div[@t-else and descendant::table[@name='stock_backorder_table']]" position="replace"/>

        <!-- 8. Remove signature section: batch has no signature field.
             Two elements need removing: the conditional oe_structure and the
             signature div itself (both reference o.signature). -->
        <xpath expr="//div[@t-if='not o.signature']" position="replace"/>
        <div name="signature" position="replace"/>

        <!-- 9. Remove observations comment: stock_ux adds o.observations to the parent
             template but stock.picking.batch does not have that field -->
        <p name="comment" position="replace"/>

    </template>

</odoo>
