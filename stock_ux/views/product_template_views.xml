<?xml version="1.0"?>
<odoo>
    <!-- desactivamos esta vista porque la busqueda por warehouse y location ya viene por la vista de template. TODO hacer PR a odoo -->
    <record id="stock.product_search_form_view_stock" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

  <!-- Hacemos que la vista que heredamos sea vista hereada no primary para este caso -->
  <record id="stock.product_template_search_form_view_stock" model="ir.ui.view">
    <field name="mode">extension</field>
  </record>

    <record id="stock.product_template_action_product" model="ir.actions.act_window">
        <field name="context">{"search_default_goods": 1, "default_is_storable": True, "stock_product_template": 1}</field>
    </record>

    <record id="view_stock_available_form" model="ir.ui.view">
        <field name="name">product.template.form.free.qty.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <button name="action_product_tmpl_forecast_report" position="after">
                <button type="object" name="action_open_quants" invisible="not show_on_hand_qty_status_button" class="oe_stat_button" icon="inventory_2">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value d-flex gap-1">
                            <field name="free_qty" nolabel="1" class="oe_inline"/>
                            <field name="uom_name" class="oe_inline"/>
                        </span>
                        <span class="o_stat_text">Free</span>
                    </div>
                </button>
            </button>
        </field>
    </record>

    <record id="view_stock_product_template_free_qty_tree" model="ir.ui.view">
        <field name="name">product.template.free.qty.list</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_stock_product_template_tree"/>
        <field name="arch" type="xml">
            <field name="qty_available" position="after">
                <field name="free_qty" invisible="not show_on_hand_qty_status_button" groups="stock.group_stock_user" optional="show" decoration-danger="free_qty &lt; 0" decoration-bf="1"/>
            </field>
        </field>
    </record>

</odoo>
