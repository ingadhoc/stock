<?xml version="1.0"?>
<odoo>

    <record id="view_picking_type_form" model="ir.ui.view">
        <field name="name">stock.picking.type.form</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='second']" position="after">
                <group string="Advance Configuration" name="advance_configuration">
                    <group name="left_advance_configuration">
                        <field name="block_additional_quantity"/>
                        <field name="block_manual_lines"/>
                        <field name="block_picking_deletion"/>
                    </group>
                    <group name="right_advance_configuration">
                        <field name="restrict_number_package"/>
                        <field name="number_of_packages"/>
                    </group>
                </group>
            </xpath>
            <field name="sequence_id" position="after">
                <field name="mail_template_id"  context="{'default_model': 'stock.picking'}"/>
            </field>
        </field>
    </record>

</odoo>
