<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Make description group always visible in lot form view -->
    <record id="view_production_lot_form_inherit_stock_ux" model="ir.ui.view">
        <field name="name">stock.lot.form.stock.ux</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <!-- Make description group always visible -->
            <group name="description" position="attributes">
                <attribute name="invisible">0</attribute>
            </group>
        </field>
    </record>
</odoo>
