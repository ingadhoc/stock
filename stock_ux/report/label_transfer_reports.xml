<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format for 10x15cm labels (4x6 inches) -->
    <record id="paperformat_label_10x15" model="report.paperformat">
        <field name="name">Label 10x15cm (4x6")</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">150</field>
        <field name="page_width">100</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">203</field>
    </record>

    <!-- ZPL Report Action for Thermal Printers -->
    <record id="action_custom_barcode_transfer_template_view_zpl" model="ir.actions.report">
        <field name="name">Etiquetas de Productos del picking (ZPL)</field>
        <field name="model">product.label.layout</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">stock_ux.custom_barcode_transfer_template_view_zpl</field>
        <field name="report_file">stock_ux.custom_barcode_transfer_template_view_zpl</field>
        <field name="print_report_name">'Label_%s.zpl' % (object.line_ids[0].move_id.picking_id.name if object.line_ids else 'Picking')</field>
        <field name="binding_model_id" ref="product.model_product_label_layout"/>
        <field name="binding_type">report</field>
    </record>

    <!-- PDF Report Action (Fallback for standard printers) -->
    <record id="action_custom_label_transfer_template_view_pdf" model="ir.actions.report">
        <field name="name">Etiquetas de Productos del picking (PDF)</field>
        <field name="model">product.label.layout</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_ux.custom_label_transfer_template_view_pdf</field>
        <field name="report_file">stock_ux.custom_label_transfer_template_view_pdf</field>
        <field name="print_report_name">'Label_%s.pdf' % (object.line_ids[0].move_id.picking_id.name if object.line_ids else 'Picking')</field>
        <field name="binding_model_id" ref="product.model_product_label_layout"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_label_10x15"/>
    </record>
</odoo>
