<odoo>
    <record id="view_picking_detail_tree" model="ir.ui.view">
        <field name="name">stock.picking_detail</field>
        <field name="model">stock.picking.state_detail</field>
        <field name="arch" type="xml">
            <list editable="bottom" sample="1" multi_edit="1" export_xlsx="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state"/>
                <field name="picking_type"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_picking_detail_search" model="ir.ui.view">
        <field name="name">stock.picking_detail.search</field>
        <field name="model">stock.picking.state_detail</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="state"/>
                <field name="picking_type"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_picking_type" string="Operation Type" context="{'group_by': 'picking_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="stock_picking_state_detail_action" model="ir.actions.act_window">
        <field name="name">Picking State Detail</field>
        <field name="res_model">stock.picking.state_detail</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_picking_detail_search"/>
        <field name="context">{'search_default_group_by_picking_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a state detail
            </p>
            <p>
                State details split a transfer status into steps of your own, for example
                "Waiting for authorization" and "Authorized" within "Ready". Each transfer
                gets the first state detail of its status and operation type, and you can
                change it from the transfer form.
            </p>
        </field>
    </record>

    <menuitem
        name="Picking State Detail"
        id="menu_state_detail"
        sequence="20"
        action="stock_picking_state_detail_action"
        parent="stock.menu_stock_config_settings"
        />
</odoo>
