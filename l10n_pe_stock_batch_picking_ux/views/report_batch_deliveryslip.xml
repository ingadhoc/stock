<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        l10n_pe_edi_stock adds a non-primary inheritance on stock.report_delivery_document
        injecting a block guarded by t-if="o.l10n_pe_edi_status == 'sent'". When
        stock_batch_picking_ux.report_batch_delivery_document is built as primary off
        stock.report_delivery_document, that PE block is carried over. At render time
        `o` is a stock.picking.batch (which has no l10n_pe_edi_status field) and
        Qweb raises AttributeError.

        Strip the PE block from the batch primary template so the report renders
        cleanly when both modules coexist.
    -->
    <template id="report_batch_delivery_document"
              inherit_id="stock_batch_picking_ux.report_batch_delivery_document">
        <xpath expr="//t[contains(@t-if, 'l10n_pe_edi_status')]" position="replace"/>
    </template>

</odoo>
