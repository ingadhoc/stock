<odoo>
    <!-- stock.picking.type -->
    <record id="view_picking_type_form" model="ir.ui.view">
        <field name="name">stock.picking.type.form (stock_declared_value)</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <group name="second">
                <label for="automatic_declare_value"/>
                <div class="row">
                    <div class="col-md-3">
                        <field name="automatic_declare_value"/>
                    </div>
                    <div class="col-md-9">
                        <field name="pricelist_id" placeholder="Pricelist" invisible="not automatic_declare_value"/>
                    </div>
                </div>
            </group>
        </field>
    </record>
</odoo>
